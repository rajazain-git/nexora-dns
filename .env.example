# ========================================================
# NEXORA DNS — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# Public Site Configuration
NEXT_PUBLIC_SITE_NAME="NEXORA DNS"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR" # PKR or USD

# Firebase Client Configuration (Frontend Auth & Firestore)
# Fill these with your Firebase Console Project credentials:
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="nexora-dns.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="nexora-dns"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="nexora-dns.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Firebase Admin SDK Configuration (Server-Side privileged operations)
# NEVER commit these keys or expose them in NEXT_PUBLIC_* variables
FIREBASE_PROJECT_ID="nexora-dns"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@nexora-dns.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Admin Master Role / Whitelist Email (Auto-granted admin on registration/login)
ADMIN_EMAILS="admin@nexoradns.com,zain@nexoradns.com"

# Payment Gateways (Live / Sandbox Configuration)
# When sandbox is true, system runs in secure simulated sandbox mode with real validation
PAYMENT_SANDBOX_MODE="true"

# Easypaisa API Credentials (Sandbox / Production)
EASYPAISA_STORE_ID="12345"
EASYPAISA_HASH_KEY="sandbox_hash_key_easypaisa"
EASYPAISA_MERCHANT_NO="03001234567"
EASYPAISA_ACCOUNT_TITLE="NEXORA GAMING TECHNOLOGIES"

# JazzCash API Credentials (Sandbox / Production)
JAZZCASH_MERCHANT_ID="MC12345"
JAZZCASH_PASSWORD="jazzcash_sandbox_password"
JAZZCASH_INTEGRITY_SALT="jazzcash_sandbox_salt"
JAZZCASH_ACCOUNT_TITLE="NEXORA GAMING TECHNOLOGIES"

# Stripe / International Card Gateway (Optional)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Automated DNS Provisioning Provider Service (Optional external DNS API)
DNS_PROVIDER_API_ENDPOINT="https://api.dns-provider.internal/v1"
DNS_PROVIDER_API_KEY="secret_dns_provisioner_key"

# Email Notifications (Resend / SMTP / SendGrid)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_USER="resend"
SMTP_PASS="re_..."
NOTIFICATION_FROM_EMAIL="support@nexoradns.com"
